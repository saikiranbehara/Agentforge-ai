# ==========================================
# AgentForge Environment Configuration
# ==========================================

# AI Provider Configuration: MOCK | GEMINI | OPENAI
AI_PROVIDER=MOCK

# Google Gemini API Key (Required when AI_PROVIDER=GEMINI)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=

# OpenAI API Key (Required when AI_PROVIDER=OPENAI)
# Get a key from OpenAI Platform: https://platform.openai.com/
OPENAI_API_KEY=

# Selected AI Model:
# For Gemini: gemini-1.5-pro, gemini-1.5-flash
# For OpenAI: gpt-4o, gpt-4o-mini
AI_MODEL=gemini-1.5-pro

# Database Configuration (for Docker Compose)
POSTGRES_DB=agentforge
POSTGRES_USER=agentforge
POSTGRES_PASSWORD=agentforge_secret

# Security & JWT Configuration
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# Sandbox Execution Mode: PROCESS | DOCKER
AGENTFORGE_SANDBOX_TYPE=PROCESS
